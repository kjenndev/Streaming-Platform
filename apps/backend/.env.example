# Create a dedicated PostgreSQL role/database; replace BOTH placeholders.
DATABASE_URL=postgresql://streaming_platform:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/streaming_platform
REDIS_URL=redis://127.0.0.1:6379/0
# Generate privately, e.g. openssl rand -hex 48. Never commit real .env files.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
HTTP_PORT=3000
RTMP_PORT=1935
MEDIA_HTTP_PORT=8000
VERBOSE=false

# Optional MSS delegation. Use a dedicated Ed25519 public key and independent
# introspection token; never reuse JWT_SECRET or an administrator credential.
MSS_DELEGATION_ENABLED=false
MSS_DELEGATION_ISSUER=
MSS_DELEGATION_BROWSER_ORIGIN=
MSS_DELEGATION_AUDIENCE=streaming-platform
MSS_DELEGATION_PUBLIC_KEY=
MSS_DELEGATION_INTROSPECTION_URL=
MSS_DELEGATION_INTROSPECTION_TOKEN=
MSS_DELEGATION_INGEST_URL=
MSS_DELEGATION_CHANNEL_MAP={}
