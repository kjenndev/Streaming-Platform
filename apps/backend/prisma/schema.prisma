generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  passwordHash      String
  roles             UserRole[]
  authorizedStreams Stream[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Stream {
  id                  String   @id @default(uuid())
  channelName         String   @unique
  streamKey           String   @unique
  isLive              Boolean  @default(false)
  isDisabled          Boolean  @default(false)
  isRecordingEnabled  Boolean  @default(false)
  lastStartedAt       DateTime?
  isPasswordProtected Boolean  @default(false)
  password            String?
  restreamUrls        Json     @default("[]")
  authorizedUsers     User[]
  recordings          Recording[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Recording {
  id          String   @id @default(uuid())
  streamId    String
  stream      Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  title       String?
  fileName    String
  filePath    String
  duration    Int?     // in seconds
  fileSize    BigInt?  // in bytes
  startedAt   DateTime
  endedAt     DateTime
  createdAt   DateTime @default(now())
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  type        String   @default("string") // string, number, boolean
  updatedAt   DateTime @updatedAt
}

model SecurityLog {
  id        String   @id @default(uuid())
  event     String
  userId    String?
  username  String?
  ip        String?
  details   String?
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  STREAM_MANAGER
  CLIENT
}
